{
  "name": "@meet_patel_12/authflow-react",
  "version": "0.1.0",
  "description": "AuthFlow React SDK — hooks and provider for the Authorization Code + PKCE flow",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --external react",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "@meet_patel_12/authflow-js": "^0.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.0.0",
    "jsdom": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "@meet_patel_12/authflow-js": "file:../authflow-js"
  },
  "keywords": [
    "authflow",
    "oauth2",
    "oidc",
    "react",
    "hooks",
    "auth"
  ],
  "license": "MIT",
  "sideEffects": false
}
