{
  "name": "@meet_patel_12/authflow-js",
  "version": "0.1.0",
  "description": "AuthFlow SDK for browser-based single-page applications",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "jsdom": "^29.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "keywords": [
    "authflow",
    "oauth2",
    "oidc",
    "auth",
    "spa"
  ],
  "license": "MIT",
  "sideEffects": false,
  "author": ""
}
