{
  "name": "@meet_patel_03/authflow-js",
  "version": "0.1.2",
  "description": "AuthFlow SDK for browser-based single-page applications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "jsdom": "^29.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "keywords": [
    "authflow",
    "oauth2",
    "oidc",
    "auth",
    "spa"
  ],
  "license": "MIT",
  "sideEffects": false,
  "author": "Meet Patel (https://github.com/Meet-Patel-12)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Meet-Patel-12/AuthFlow"
  }
}
