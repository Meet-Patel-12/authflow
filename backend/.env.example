# ============================================
# MONGODB DATABASE
# ============================================
MONGODB_URI=mongodb://localhost:27017/authflow

# ============================================
# REDIS CACHE (Optional - for rate limiting & sessions)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# JWT SECRETS (CHANGE THESE IN PRODUCTION!)
# ============================================
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# ============================================
# SESSION & SECURITY
# ============================================
SESSION_SECRET=your-super-secret-session-key-change-in-production-min-32-chars

# ============================================
# APP SETTINGS
# ============================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5000

# ============================================
# OAUTH PROVIDERS (Optional)
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# EMAIL SERVICE (Optional - for sending emails)
# ============================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@authflow.com
